# Reference for the Render dashboard (Environment tab). Do not put real values in this file.

NODE_ENV=production
PORT=10000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shadow-network?retryWrites=true&w=majority

PINATA_API_KEY=<from pinata.cloud → API Keys>
PINATA_SECRET_KEY=<from pinata.cloud → API Keys>
PINATA_GATEWAY=https://gateway.pinata.cloud

AI_ENGINE_URL=https://<your-ai-service>.onrender.com
AI_ENGINE_KEY=<same random value as the AI engine's AI_ENGINE_KEY>

JWT_SECRET=<long random string>
API_SECRET=<shared login secret>
ALLOWED_ORIGINS=https://<your-frontend>.vercel.app
