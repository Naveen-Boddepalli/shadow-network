PORT=5000
MONGO_URI=mongodb://localhost:27017/shadow-network

# IPFS: leave the Pinata keys empty to use a local Kubo node (ipfs daemon)
IPFS_HOST=127.0.0.1
IPFS_PORT=5001
IPFS_PROTOCOL=http
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Python AI engine
AI_ENGINE_URL=http://localhost:8000
# Optional shared secret; set the same value in the AI engine to lock down its endpoints
AI_ENGINE_KEY=

# Auth. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
# Users log in with this shared secret to receive a 24h JWT
API_SECRET=change_me

# Comma-separated list of exact frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
