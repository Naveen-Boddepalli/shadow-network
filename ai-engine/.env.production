# Reference for the Render dashboard (Environment tab). Do not put real values in this file.

# LLM fallback chain: three OpenAI-compatible slots, tried in order.
LLM_1_BASE_URL=https://api.groq.com/openai/v1
LLM_1_MODEL=openai/gpt-oss-120b
LLM_1_API_KEY=<your Groq API key>
LLM_2_BASE_URL=https://api.groq.com/openai/v1
LLM_2_MODEL=qwen/qwen3.8-27b
LLM_2_API_KEY=<same Groq key, or none>
LLM_3_BASE_URL=https://api.groq.com/openai/v1
LLM_3_MODEL=openai/gpt-oss-20b
LLM_3_API_KEY=<same Groq key, or none>
IPFS_GATEWAY=https://gateway.pinata.cloud
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=shadow-network
AI_ENGINE_KEY=<same random value as the backend's AI_ENGINE_KEY>
