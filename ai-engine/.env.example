# Local IPFS gateway (Kubo). In production this is the Pinata gateway.
IPFS_GATEWAY=http://127.0.0.1:8080

# ── LLM (summaries and Q&A) ─────────────────────────────────────
# Three OpenAI-compatible slots, tried in order: a slot that is rate limited,
# down or misconfigured hands the request to the next. Any provider that speaks
# POST {base_url}/chat/completions works: Groq, Gemini
# (https://generativelanguage.googleapis.com/v1beta/openai), OpenRouter, Ollama...
# A slot with an empty model or a "none" key is off.
# Groq limits tokens per minute per model, so three different models is a real fallback.
# Current Groq models: https://console.groq.com/docs/models
LLM_1_BASE_URL=https://api.groq.com/openai/v1
LLM_1_MODEL=openai/gpt-oss-120b
LLM_1_API_KEY=
LLM_2_BASE_URL=https://api.groq.com/openai/v1
LLM_2_MODEL=qwen/qwen3.8-27b
LLM_2_API_KEY=none
LLM_3_BASE_URL=https://api.groq.com/openai/v1
LLM_3_MODEL=openai/gpt-oss-20b
LLM_3_API_KEY=none

# ── Embeddings (retrieval and semantic search) ──────────────────
# Runs locally on onnxruntime, no API key: all-MiniLM-L6-v2, int8 (~23 MB),
# downloaded from Hugging Face on first use into ai-engine/.model-cache.
# EMBEDDING_ONNX_MODEL=Xenova/all-MiniLM-L6-v2

# Summary input budget (characters sent to the LLM) and target length (words)
# SUMMARY_INPUT_CHARS=24000
# SUMMARY_WORDS=250

# MongoDB Atlas, used for vector search ($vectorSearch requires Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=shadow-network

# Optional shared secret. When set, the backend must send the same value
# (its AI_ENGINE_KEY) or every endpoint except /health returns 401.
AI_ENGINE_KEY=
