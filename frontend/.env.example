# Backend API base URL. In development you can leave this unset: Vite proxies
# /api/v1 to http://localhost:5000 (see vite.config.js).
VITE_API_URL=http://localhost:5000/api/v1

# true = start a browser IPFS node (Helia) and enable the Peers page
VITE_P2P_MODE=false

# Comma-separated multiaddrs of Shadow Network relays (see /p2p-relay). Browsers
# can't find each other without one. Use the address the relay prints, e.g.
# /ip4/192.168.1.20/tcp/9090/ws/p2p/12D3KooW...
VITE_P2P_RELAYS=

# false = skip public IPFS bootstrap nodes and delegated routing; only talk to
# the relay(s) above. Use for a pure offline campus LAN.
VITE_P2P_PUBLIC_NETWORK=true
